{
  "name": "berth",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ./src ./app --ext .jsx,.ts,.tsx",
    "lint:fix": "eslint ./src ./app --ext .jsx,.ts,.tsx --fix",
    "stylelint": "stylelint \"**/*.{css,scss,sass}\"",
    "stylelint:fix": " stylelint \"**/*.{css,scss,sass}\" --fix",
    "svg:transform-common": "svgr ./src/shared/assets/icons/svg/common --out-dir ./src/shared/assets/icons/components/common --config-file ./svgr/common.config.js --prettier-config ./.prettierrc.json && eslint ./src/shared/assets/icons/components/common --fix --no-error-on-unmatched-pattern",
    "svg:transform-external": "svgr ./src/shared/assets/icons/svg/external --out-dir ./src/shared/assets/icons/components/external --config-file ./svgr/external.config.js --prettier-config ./.prettierrc.json && eslint ./src/shared/assets/icons/components/external --fix --no-error-on-unmatched-pattern",
    "svg:transform": "yarn svg:transform-common && yarn svg:transform-external",
    "prettier": " prettier \"./**/*.{ts,tsx}\"",
    "prettier:write": " prettier --write \"./**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.88.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.3.6",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@svgr/babel-plugin-replace-jsx-attribute-value": "^8.0.0",
    "@svgr/cli": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tanstack/react-query-devtools": "^5.103.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "^10.6.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "30",
    "jest-environment-jsdom": "30",
    "jest-fixed-jsdom": "^0.0.11",
    "lint-staged": "^17.5.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.8",
    "sass-embedded": "^1.104.1",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-clean-order": "^10.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "validate-branch-name": "^1.3.2",
    "vite": "^8.3.0"
  },
  "description": "Платформа сборки команд для пет-проектов",
  "engines": {
    "node": ">=24"
  },
  "validate-branch-name": {
    "pattern": "^(main|pre-prod|develop){1}$|^(feat|fix|chore|hotfix|refactor)(|\\((main|pre-prod|develop)\\))/DR-[0-9]{1,5}-.+$|^(feat|fix|chore|hotfix|refactor)/.+$",
    "errorMsg": "Invalid branch name"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
