{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "incremental": true,

    /* Language */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "allowArbitraryExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    // Unused locals are policed by @typescript-eslint/no-unused-vars instead: unlike
    // tsc it can be switched off per folder, which the generated icon components
    // in shared/assets/icons/components need.
    "noUnusedLocals": false,

    "skipLibCheck": true,
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "plugins": [{ "name": "next" }],

    // No baseUrl: it is deprecated in TS 6, and since TS 5.0 paths resolve
    // relative to the tsconfig itself. Mirrored in jest.config.ts moduleNameMapper.
    "paths": {
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  // `**/*.ts` covers every .d.ts but skips dot-folders, so .storybook and the route
  // types Next generates in .next/types are listed explicitly.
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "coverage", "storybook-static"]
}
